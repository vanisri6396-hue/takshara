# ─────────────────────────────────────────────────────────────
# Takshara — Production-ready .gitignore
# ─────────────────────────────────────────────────────────────

# Dependencies
node_modules
.pnp
.pnp.js

# Build outputs
dist
dist-ssr
build
*.tsbuildinfo
vite.config.ts.timestamp-*

# Environment variables & secrets
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging
secrets
secrets.json
*.secret
*.key
*.pem
*.p12
*.pfx

# Supabase temporary files
.supabase/
**/.supabase/
*.db
*.db-journal
supabase/.temp/
supabase/functions/_shared/.env
supabase/.env

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Cache
.cache/
.eslintcache
.oxlintcache
*.tsbuildinfo

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.swp
*.swo
*.swn
.DS_Store
Thumbs.db

# Testing & coverage
coverage/
.nyc_output/
*.lcov

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Temporary files
tmp/
temp/
.tmp/
*.tmp
*.bak
*.backup
*.old

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# Framework specific
.next/
.nuxt/
.vuepress/dist
.serverless/
.fusebox/
.dynamodb/
.vercel/